# Copy to .env for local development. Matches docker-compose.yml port offsets.
DATABASE_URL=postgres://smma:smma@localhost:55432/smma
REDIS_URL=redis://localhost:56379
API_PORT=3001
# Base domain for subdomain routing. Client subdomains and the reserved `admin.`
# surface are resolved by stripping this suffix off the request Host header.
BASE_DOMAIN=localhost
# Shared secret gating the Superadmin `admin.` API surface. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUPERADMIN_TOKEN=dev-superadmin-token-change-me
# Transactional email (password-reset links). EMAIL_FROM is the sender address.
# Set RESEND_API_KEY to send real mail via Resend; leave it unset in local dev
# and the app logs the reset link to the console instead of delivering it.
EMAIL_FROM=no-reply@localhost
# RESEND_API_KEY=
# Vite dev server proxies /api to the Fastify API; see packages/web/vite.config.ts
