# Copy to .env for local development. Matches docker-compose.yml port offsets.
DATABASE_URL=postgres://smma:smma@localhost:55432/smma
REDIS_URL=redis://localhost:56379
API_PORT=3001
# Base domain for subdomain routing. Client subdomains and the reserved `admin.`
# surface are resolved by stripping this suffix off the request Host header.
BASE_DOMAIN=localhost
# Shared secret gating the Superadmin `admin.` API surface. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUPERADMIN_TOKEN=dev-superadmin-token-change-me
# Transactional email (password-reset links). EMAIL_FROM is the sender address.
# Set RESEND_API_KEY to send real mail via Resend; leave it unset in local dev
# and the app logs the reset link to the console instead of delivering it.
EMAIL_FROM=no-reply@localhost
# RESEND_API_KEY=
# Encrypts platform tokens at rest (ADR 0006). Required. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEY CUSTODY: this key lives outside the database on purpose. Lose it and every
# Client must reconnect every social account — back it up somewhere safe.
TOKEN_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
# Origin Facebook and TikTok return Users to after login — a page the SPA
# renders, so in dev this is the Vite dev server, not the API. One fixed URI per
# platform is derived from it (/oauth/facebook/callback, /oauth/tiktok/callback);
# Meta will not whitelist a wildcard, so it cannot be per-Client-subdomain. Must
# match the redirect URI list in the Meta and TikTok apps exactly.
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
# Our Meta app — Facebook *and* Instagram, which share one app and one login
# (docs/platform-app-setup.md). Leave unset in local dev and both use the fake
# Publisher — the connect flow works end-to-end without reaching Facebook. Set
# both to build against a real test Page. META_APP_SECRET also verifies Meta's
# deauthorization callback; without it that callback refuses every request rather
# than trusting an unverifiable one.
# META_APP_ID=
# META_APP_SECRET=
# Our TikTok app (docs/platform-app-setup.md §2). Independent of Meta's: the two
# are separate reviews on separate timelines, so either can be live while the
# other is still faked. Unset -> TikTok uses the fake Publisher.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Vite dev server proxies /api to the Fastify API; see packages/web/vite.config.ts
